# Copy into Replit Secrets / environment configuration. Do not commit real values.
DATABASE_URL=

# API server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SUCCESS_REDIRECT=

# Optional phone OTP via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional initial admin bootstrap; authenticate with the matching provider.
ADMIN_EMAIL=
ADMIN_PHONE=

# Clients
EXPO_PUBLIC_API_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000
